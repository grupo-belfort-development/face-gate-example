# Copie para .env.local e preencha com a chave criada no portal do Face Gate (Chaves de acesso).
# A chave precisa ter na lista de IPs liberados o IP público desta máquina (o servidor chama a API com ela).
FACE_GATE_CLIENT_ID=
FACE_GATE_CLIENT_SECRET=
# Opcional: URL da API do Face Gate. Vazio = produção (https://face-gate-api.beltec.ai).
FACE_GATE_API_URL=
